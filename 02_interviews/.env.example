POSTGRES_DB=interviews
POSTGRES_USER=interviews
POSTGRES_PASSWORD=interviews_dev
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173
FRONTEND_URL=http://localhost:5173
# Compose uses this URL inside the backend container; local backend commands may
# override it with sqlite:///./interviews.db or a host PostgreSQL URL.
DATABASE_URL=postgresql+psycopg://interviews:interviews_dev@postgres:5432/interviews
# Required only when starting the backend with a seeded development admin.
DEV_ADMIN_EMAIL=admin@example.test
DEV_ADMIN_PASSWORD=correct-horse
ADMIN_SESSION_SECRET=change-me-for-local-development
INVITE_TOKEN_SECRET=change-me-for-local-development
CANVAS_TOKEN_SECRET=change-me-for-local-development
DRAWIO_STATE_DIR=/var/lib/canvas-sync
INVITE_EXPIRY_MINUTES=60
CANVAS_SYNC_URL=http://localhost:8787
CANVAS_SYNC_INTERNAL_URL=http://canvas-sync:8787
CANVAS_SYNC_PORT=8787
CANVAS_EDITOR_PORT=8090
# Backend CORS and WebSocket origin allowlists.
FRONTEND_ORIGINS=http://localhost:5173
WS_ALLOWED_ORIGINS=http://localhost:5173
# Federated admin auth is disabled by default; configure real provider values
# only outside local/CI. The mock mode is deterministic for backend tests.
APP_SESSION_TTL_MINUTES=60
APP_COOKIE_SECURE=false
APP_COOKIE_DOMAIN=
GOOGLE_PROVIDER_MODE=disabled
GOOGLE_CLIENT_ID=
GOOGLE_PUBLIC_KEY=
GOOGLE_ISSUER=https://accounts.google.com
GOOGLE_ALLOWED_DOMAINS=
GOOGLE_AUTO_APPROVE=false
RECAPTCHA_MODE=mock
RECAPTCHA_SECRET=
RECAPTCHA_ALLOWED_HOSTNAMES=
RECAPTCHA_ALLOW_SCORE=0.7
RECAPTCHA_STEPUP_SCORE=0.4
RECAPTCHA_MAX_AGE_SECONDS=120
# Browser-facing service URLs (Vite build-time variables).
VITE_API_URL=http://localhost:8000
VITE_GOOGLE_CLIENT_ID=
VITE_RECAPTCHA_MODE=mock
VITE_RECAPTCHA_SITE_KEY=
VITE_CANVAS_SYNC_URL=http://localhost:8787
VITE_CANVAS_MODE=drawio
VITE_DRAWIO_EDITOR_URL=http://localhost:8090/editor.html
# Set to mock to run the frontend with seeded data and no FastAPI/Postgres.
VITE_SERVICE_MODE=real
# Optional Playwright base URL override.
E2E_BASE_URL=http://localhost:5173
# Optional PostgreSQL URL used only by tests/test_migration.py.
# TEST_DATABASE_URL=postgresql+psycopg://interviews:interviews_dev@localhost:5432/interviews
